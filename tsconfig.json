{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "jsxImportSource": "solid-js",
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "rootDirs": ["src"],
    "types": ["vite/client"]
  },
  "include": ["src", "test", "vitest.config.ts", "vitest-bench.config.ts"],
  "exclude": ["src-tauri/target", "**/out/tauri-codegen-assets/**"]
}
