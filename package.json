{
  "name": "fridge",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "dev": "tauri dev",
    "build": "tauri build",
    "lint": "eslint .",
    "prettier": "prettier --write . --config .prettierrc",
    "cargo:format": "cd src-tauri && cargo fmt",
    "format": "pnpm prettier && pnpm cargo:format",
    "tsc": "pnpm -r exec tsc --noEmit --skipLibCheck",
    "test": "vitest run --config=vitest.config.ts",
    "test:browser": "vitest run --config=vitest.browser.config.ts",
    "lint-staged": "lint-staged",
    "prepare": "simple-git-hooks"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,scss,html,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "dependencies": {
    "@jaames/iro": "^5.5.2",
    "@sledge-pdm/core": "^1.2.2",
    "@sledge-pdm/ui": "^1.2.5",
    "@solid-primitives/deep": "^0.3.3",
    "@solid-primitives/map": "^0.7.2",
    "@solid-primitives/mouse": "^2.1.4",
    "@solid-primitives/raf": "^2.3.2",
    "@solid-primitives/scheduled": "^1.5.2",
    "@solid-primitives/scroll": "^2.1.3",
    "@solid-primitives/timer": "^1.4.3",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@tiptap/core": "^3.18.0",
    "@tiptap/extension-document": "^3.18.0",
    "@tiptap/extension-hard-break": "^3.18.0",
    "@tiptap/extension-highlight": "^3.18.0",
    "@tiptap/extension-invisible-characters": "^3.18.0",
    "@tiptap/extension-paragraph": "^3.18.0",
    "@tiptap/extension-text": "^3.18.0",
    "@tiptap/extensions": "^3.18.0",
    "@tiptap/pm": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "interactjs": "^1.10.27",
    "mitt": "^3.0.1",
    "msgpackr": "^1.11.8",
    "solid-js": "^1.9.11",
    "solid-tiptap": "^0.8.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@acab/ecsstatic": "0.9.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.9.6",
    "@vitest/browser-playwright": "^4.0.18",
    "dotenv": "^17.2.3",
    "lint-staged": "^15.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "simple-git-hooks": "^2.13.0",
    "vitest": "^4.0.18",
    "vite": "^7.3.1",
    "vite-plugin-glsl": "^1.5.5",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-solid": "^2.11.10",
